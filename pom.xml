<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.4</version>
        <relativePath/>
    </parent>

    <groupId>io.kikwiflow.agents</groupId>
    <artifactId>kikwi-agents-parent</artifactId>
    <version>0.1.6</version>
    <packaging>pom</packaging>
    <name>Kikwi Agents</name>
    <description>Plataforma de agentes conversacionais multi-tenant orquestrada e auditada pelo Kikwiflow.</description>
    <url>https://kikwiflow.io</url>
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>http://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>efagundes93</id>
            <name>Emiliano Fagundes</name>
            <email>emiliano@atoxfy.com</email>
        </developer>
    </developers>
    <scm>
        <connection>scm:git:https://github.com/atoxfy/kikwi-agents.git</connection>
        <developerConnection>scm:git:https://github.com/atoxfy/kikwi-agents.git</developerConnection>
        <url>https://github.com/atoxfy/kikwi-agents</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <kikwiflow.version>0.1.84</kikwiflow.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>agents-model</module>
        <module>agents-llm-api</module>
        <module>agents-llm-anthropic</module>
        <module>agents-llm-gemini</module>
        <module>agents-llm-fake</module>
        <module>agents-channels-api</module>
        <module>agents-conversation</module>
        <module>agents-runtime</module>
        <module>agents-dms-client</module>
        <module>agents-spring-boot-starter</module>
        <module>agents-app</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-llm-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-llm-anthropic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-llm-gemini</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-llm-fake</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-channels-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-conversation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.kikwiflow.agents</groupId>
                <artifactId>agents-dms-client</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <profiles>
        <!--
          Publicação no Maven Central (mesmo processo do motor):
            powershell -ExecutionPolicy Bypass -File .elease.ps1   (= mvn -Prelease clean deploy -DskipTests -pl '!agents-app')
          O agents-app é só demonstração e não é publicado.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>flatten-maven-plugin</artifactId>
                        <version>1.6.0</version>
                        <configuration>
                            <updatePomFile>true</updatePomFile>
                            <flattenMode>oss</flattenMode>
                        </configuration>
                        <executions>
                            <execution>
                                <id>flatten</id>
                                <phase>process-resources</phase>
                                <goals><goal>flatten</goal></goals>
                            </execution>
                            <execution>
                                <id>flatten.clean</id>
                                <phase>clean</phase>
                                <goals><goal>clean</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.4.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <tokenAuth>true</tokenAuth>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.0</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <failOnError>false</failOnError>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <gpgArguments>
                                <arg>--pinentry-mode</arg>
                                <arg>loopback</arg>
                            </gpgArguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
