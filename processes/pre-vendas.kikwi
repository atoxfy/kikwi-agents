    "REGISTRAR_PERDA": {
      "id": "REGISTRAR_PERDA",
      "name": "Registrar perda",
      "type": "EXECUTABLE_TASK",
      "description": "Registra o lead perdido (motivo, dados coletados) para relatórios e futuras campanhas. Sem motivo informado, usa SEM_RESPOSTA.",
      "commitBefore": true,
