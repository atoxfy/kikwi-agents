<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.kikwiflow.agents</groupId>
        <artifactId>kikwi-agents-parent</artifactId>
        <version>0.1.6</version>
    </parent>

    <artifactId>agents-app</artifactId>
    <name>Kikwi Agents :: App</name>
    <description>Aplicação Spring Boot que embute o motor Kikwiflow e monta a plataforma.</description>

    <dependencies>
        <dependency><groupId>io.kikwiflow.agents</groupId><artifactId>agents-spring-boot-starter</artifactId></dependency>
        <!-- Motor em memória para os testes ponta a ponta (EmbeddedEngine), sem Mongo. -->
        <dependency><groupId>io.kikwiflow</groupId><artifactId>kikwi-in-memory-addons</artifactId><version>${kikwiflow.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.assertj</groupId><artifactId>assertj-core</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <resources>
            <resource><directory>src/main/resources</directory></resource>
            <!-- Os processos versionados na raiz (processes/) vão para classpath:processes/ e o auto-deploy do motor os lê. -->
            <resource>
                <directory>${project.basedir}/../processes</directory>
                <targetPath>processes</targetPath>
                <includes><include>*.kikwi</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin>
        </plugins>
    </build>
</project>
